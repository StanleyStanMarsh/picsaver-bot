# Telegram bot
BOT_TOKEN=your_telegram_bot_token_here

# Optional proxy (leave empty/comment if not needed)
PROXY_PROTO=socks5
PROXY_ADDRESS=host.docker.internal
PROXY_PORT=10808

# Queue (compose overrides QUEUE_ADDRESS to "redis" inside containers)
QUEUE_ADDRESS=localhost
QUEUE_PORT=6379

# Postgres
DB_NAME=picsaver
DB_USER=picsaver
DB_PASSWORD=change_me

# Qdrant / CLIP (compose also sets these for services)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=user_images
CLIP_MODEL_NAME=jinaai/jina-clip-v2
CLIP_VECTOR_SIZE=1024
CLIP_DEVICE=cpu

# Public HTTPS URL of Mini App (nginx → webapp:8080). Required for WebApp button on /start.
# Example: https://picsaver.example.com/
WEBAPP_URL=

# Admin dashboard https://…/admin — HTML form login (user `admin`). Strong password; empty disables admin.
ADMIN_PASSWORD=

# Semantic search cutoffs (cosine; higher = stricter). Tunable without redeploy.
SEARCH_MIN_SCORE=0.2
SIMILAR_MIN_SCORE=0.35

# Save limits / album (Package 3 Stage A — bot)
# Max photos per Telegram media_group; larger albums are rejected (no enqueue).
SAVE_ALBUM_MAX=6
# Max photos enqueued per user in the rate window (album of 3 counts as 3).
SAVE_RATE_LIMIT=20
SAVE_RATE_WINDOW_SEC=600
# RQ job wait timeout for save (CLIP on CPU can be slow). User gets an explicit error on timeout.
SAVE_JOB_TIMEOUT=600
# Package 3 Stage B — L3: max concurrent CLIP/save jobs per user (save + embed_text + embed_image).
SAVE_USER_ACTIVE_MAX=3
# L5: soft-reject new enqueue when RQ save queue depth is this high (0 = disable reject).
SAVE_QUEUE_MAX_DEPTH=50


# Object storage (MinIO via cgr.dev/chainguard/minio — official Hub image gone).
# local = images-data volume; minio = MinIO only; dual = MinIO put with local fallback, read MinIO then local.
# Keep local until migration + gallery/delete verified on minio.
STORAGE_BACKEND=local
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=picsaver
MINIO_REGION=us-east-1
# Root user for the MinIO container (also used by minio-init to create the bucket).
MINIO_ROOT_USER=picsaver
MINIO_ROOT_PASSWORD=change_me_minio_password
# App credentials (can match root on a private compose network; rotate for prod).
MINIO_ACCESS_KEY=picsaver
# App refuses empty/placeholder MINIO_SECRET_KEY (fail-fast on startup).
MINIO_SECRET_KEY=change_me_minio_password
