# Telegram bot
BOT_TOKEN=your_telegram_bot_token_here

# Optional proxy
PROXY_PROTO=socks5
PROXY_ADDRESS=host.docker.internal
PROXY_PORT=10808

# Queue (docker-compose overrides QUEUE_ADDRESS to "redis" inside containers)
QUEUE_ADDRESS=localhost
QUEUE_PORT=6379

# Postgres
DB_NAME=picsaver
DB_USER=picsaver
# Use a strong password in real environments
DB_PASSWORD=change_me

